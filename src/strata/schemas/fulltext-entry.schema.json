{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://strata-review.org/schemas/fulltext-entry.schema.json",
  "title": "Full-text manifest entry",
  "description": "openspec:full-text-retrieval#full-text-manifest-by-identifier",
  "type": "object",
  "required": ["report", "locator", "version", "retrieved", "source", "actor"],
  "additionalProperties": false,
  "properties": {
    "report": { "type": "string", "pattern": "^rpt_[0-9a-z]{16}$" },
    "locator": { "$ref": "#/$defs/locator" },
    "version": {
      "enum": [
        "preprint",
        "accepted-manuscript",
        "version-of-record",
        "corrected",
        "retracted",
        "unknown"
      ]
    },
    "path": { "type": "string", "minLength": 1 },
    "retrieved": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "source": { "type": "string", "minLength": 1 },
    "actor": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,31}$" },
    "related": { "type": "array", "items": { "$ref": "#/$defs/locator" } },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  },
  "$defs": {
    "locator": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "doi": { "type": "string", "minLength": 1 },
        "pmid": { "type": "string", "minLength": 1 },
        "pmcid": { "type": "string", "minLength": 1 },
        "arxiv": { "type": "string", "minLength": 1 },
        "isbn": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "minLength": 1 }
      }
    }
  }
}
