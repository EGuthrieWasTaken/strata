{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://strata-review.org/schemas/import-manifest.schema.json",
  "title": "Import manifest",
  "description": "openspec:literature-import#what-import-does — imports/<id>/manifest.yaml",
  "type": "object",
  "required": [
    "id",
    "source_file",
    "digest",
    "format",
    "encoding",
    "rows_read",
    "records_created",
    "rows_rejected",
    "existing_ids_appended",
    "imported",
    "imported_by"
  ],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^imp_[0-9a-hjkmnp-tv-z]{26}$" },
    "search": { "type": ["string", "null"] },
    "via": { "type": ["string", "null"] },
    "source_file": { "type": "string", "minLength": 1 },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "format": { "type": "string", "minLength": 1 },
    "encoding": { "type": "string", "minLength": 1 },
    "column_mapping": { "type": ["object", "null"] },
    "rows_read": { "type": "integer", "minimum": 0 },
    "records_created": { "type": "integer", "minimum": 0 },
    "rows_rejected": { "type": "integer", "minimum": 0 },
    "existing_ids_appended": { "type": "integer", "minimum": 0 },
    "imported": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "imported_by": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,31}$" }
  }
}
