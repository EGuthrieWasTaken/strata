{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://strata-review.org/schemas/manifest.schema.json",
  "title": "strata.toml project manifest",
  "description": "openspec:data-schemas#project-manifest",
  "type": "object",
  "required": ["schema_version", "created_with", "project", "actors"],
  "additionalProperties": true,
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "created_with": { "type": "string" },
    "project": {
      "type": "object",
      "required": ["id", "title", "slug", "created"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "slug": { "type": "string" },
        "created": { "type": "string" },
        "registry": { "type": "object" },
        "license": { "type": "string" }
      }
    },
    "actors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["handle", "name", "role"],
        "properties": {
          "handle": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,31}$" },
          "name": { "type": "string" },
          "email": { "type": "string" },
          "orcid": { "type": "string" },
          "role": {
            "type": "string",
            "enum": ["lead", "screener", "extractor", "adjudicator", "observer", "inactive"]
          }
        }
      }
    },
    "screening": {
      "type": "object",
      "properties": {
        "stages": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "mode": { "type": "string", "enum": ["single", "dual", "dual-then-adjudicate"] },
        "adjudicators": { "type": "array", "items": { "type": "string" } },
        "blind_reviewers": { "type": "boolean" },
        "blind_metadata": { "type": "boolean" },
        "require_exclusion_reason": { "type": "boolean" },
        "assignment": { "type": "object" }
      }
    },
    "dedup": {
      "type": "object",
      "properties": {
        "auto_merge_threshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "review_threshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "source_trust": { "type": "array", "items": { "type": "string" } }
      }
    },
    "git": {
      "type": "object",
      "properties": {
        "commit_style": { "type": "string", "enum": ["structured", "plain"] },
        "require_rationale": { "type": "boolean" },
        "sync_strategy": { "type": "string", "enum": ["merge", "rebase"] },
        "remote": { "type": "string" }
      }
    },
    "enrichment": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "providers": { "type": "array", "items": { "type": "string" } },
        "contact_email": { "type": "string" }
      }
    },
    "analysis": {
      "type": "object",
      "properties": {
        "engine": { "type": "string", "enum": ["native", "metafor"] }
      }
    }
  }
}
