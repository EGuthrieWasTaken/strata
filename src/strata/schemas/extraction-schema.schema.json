{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://strata-review.org/schemas/extraction-schema.schema.json",
  "title": "Extraction coding form (extraction/schema.yaml)",
  "description": "openspec:data-extraction#extraction-schema",
  "type": "object",
  "required": ["version", "fields"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "fields": { "type": "array", "items": { "$ref": "#/$defs/field" } },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "outcome_field": { "type": "string", "minLength": 1 },
        "outcomes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "designs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "requires"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
              "requires": { "type": "array", "minItems": 1, "items": { "type": "string" } }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "field": {
      "type": "object",
      "required": ["name", "type"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "label": { "type": "string" },
        "type": {
          "enum": [
            "integer",
            "number",
            "quantity",
            "categorical",
            "multi-categorical",
            "boolean",
            "text",
            "date",
            "citation"
          ]
        },
        "required": { "type": "boolean" },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "levels": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "unit": { "type": "string", "minLength": 1 },
        "accepts_units": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "help": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "enum": ["categorical", "multi-categorical"] } } },
          "then": { "required": ["levels"] }
        },
        {
          "if": { "properties": { "type": { "const": "quantity" } }, "required": ["type"] },
          "then": { "required": ["unit"] }
        }
      ]
    }
  }
}
