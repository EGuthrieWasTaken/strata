{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://strata-review.org/schemas/rob-instrument.schema.json",
  "title": "Risk-of-bias instrument (rob/instrument.yaml)",
  "description": "openspec:risk-of-bias#instrument-definitions",
  "type": "object",
  "required": ["instrument", "version", "applies_to", "domains", "overall"],
  "additionalProperties": false,
  "properties": {
    "instrument": { "type": "string", "minLength": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "version": { "type": "string", "minLength": 1 },
    "applies_to": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "source": { "type": "string" },
    "licence_note": { "type": "string" },
    "domains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "judgements"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$" },
          "label": { "type": "string", "minLength": 1 },
          "judgements": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "algorithm": { "type": "string" },
          "signalling_questions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "options"],
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "topic": { "type": "string" },
                "text": { "type": "string" },
                "options": {
                  "type": "array",
                  "minItems": 2,
                  "uniqueItems": true,
                  "items": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        }
      }
    },
    "overall": {
      "type": "object",
      "required": ["algorithm"],
      "additionalProperties": false,
      "properties": {
        "algorithm": { "enum": ["worst-domain", "sum", "custom"] },
        "judgements": { "type": "array", "minItems": 2, "items": { "type": "string" } }
      }
    }
  }
}
