{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://strata-review.org/schemas/extraction-record.schema.json",
  "title": "Extraction record (per reviewer or consensus)",
  "description": "openspec:data-extraction#extraction-records-and-source-locators",
  "type": "object",
  "required": ["study", "reports", "schema_version", "extracted_by", "fields"],
  "additionalProperties": false,
  "properties": {
    "study": { "type": "string", "pattern": "^std_[0-9a-z]{16}$" },
    "reports": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^rpt_[0-9a-z]{16}$" }
    },
    "schema_version": { "type": "integer", "minimum": 1 },
    "extracted_by": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,31}$" }
    },
    "reconciled_by": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,31}$" },
    "fields": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["value"],
        "additionalProperties": false,
        "properties": {
          "value": {},
          "unit": { "type": "string" },
          "entered": { "type": "string" },
          "source": { "type": "string" },
          "not_reported": { "type": "boolean" }
        }
      }
    },
    "effects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["outcome", "design"],
        "properties": {
          "id": { "type": "string", "pattern": "^eff_[0-9a-z]{16}_\\d{4}$" },
          "outcome": { "type": "string", "minLength": 1 },
          "design": { "type": "string", "minLength": 1 },
          "timepoint": { "type": "string" },
          "label": { "type": "string" },
          "source": { "type": "string" },
          "moderators": { "type": "object" }
        }
      }
    }
  }
}
